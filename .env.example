# Twilio Voice + SMS
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Twilio Browser Calling (create in Twilio Console)
# 1. Create API Key → TWILIO_API_KEY_SID + TWILIO_API_KEY_SECRET
# 2. Create TwiML App → Voice Request URL: {APP_URL}/api/twilio/voice
TWILIO_API_KEY_SID=your_api_key_sid
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_TWIML_APP_SID=your_twiml_app_sid

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Public app URL (required for Twilio webhooks + recordings)
# Local dev: use ngrok, e.g. https://abc123.ngrok.io
NEXT_PUBLIC_APP_URL=http://localhost:3000
